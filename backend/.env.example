# Port configuration for the Express server
PORT=5000

# Connection string for your local or remote PostgreSQL database instance
DATABASE_URL="postgresql://postgres:password@localhost:5432/studyforge?schema=public"

# Secret key for JWT signature hashing
JWT_SECRET="your_jwt_secret_here"

# Google Gemini API key for question generation & OCR processing
GEMINI_API_KEY="your_gemini_api_key_here"
